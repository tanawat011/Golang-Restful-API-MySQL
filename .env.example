# Copy to .env (git-ignored). DEV ONLY: placeholder passwords for the local
# MySQL in compose.yaml. Never put real credentials in this file.

# MySQL in Docker (compose.yaml) and the API both read these.
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=app
DB_PASSWORD=change-me-dev-only
DB_NAME=golang_rest_api_example
MYSQL_ROOT_PASSWORD=change-me-root-dev-only

# The API listens here.
ADDR=127.0.0.1:8080

# The tests use (and empty) this database; compose creates it.
TEST_DB_NAME=golang_rest_api_example_test
